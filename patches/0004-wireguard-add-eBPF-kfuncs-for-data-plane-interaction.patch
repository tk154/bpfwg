 }
 
+/* Returns a strong reference to a peer */
+struct wg_peer *wg_allowedips_lookup_bpf(struct allowedips *table,
+					 const void *addr, u32 addr_len)
+{
+	if (addr_len == 4)
+		return lookup(table->root4, 32, addr);
+	else if (addr_len == 16)
+		return lookup(table->root6, 128, addr);
+	return NULL;
+}
