+
+struct wg_device *wg_socket_device_get_from_sk(struct sock *sk)
+{
+	struct wg_device *wg;
+
+	if (READ_ONCE(udp_sk(sk)->encap_rcv) != wg_receive)
+		return NULL;
+
+	rcu_read_lock();
+	wg = rcu_dereference_sk_user_data(sk);
+	if (likely(wg))
+		dev_hold(wg->dev);
+	rcu_read_unlock();
+
+	return wg;
+}
