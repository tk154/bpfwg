@@ -0,0 +1,18 @@
+#ifndef _WG_BPF_H
+#define _WG_BPF_H
+
+#if (IS_BUILTIN(CONFIG_WIREGUARD) && IS_ENABLED(CONFIG_DEBUG_INFO_BTF)) || \
+    (IS_MODULE(CONFIG_WIREGUARD) && IS_ENABLED(CONFIG_DEBUG_INFO_BTF_MODULES))
