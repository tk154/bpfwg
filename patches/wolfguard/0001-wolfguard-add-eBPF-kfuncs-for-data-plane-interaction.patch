+
+struct wg_device *
+wg_device_get_by_index(struct net *net, int ifindex)
+{
+	struct wg_device *wg = NULL;
+	struct net_device *dev;
+
+	rcu_read_lock();
+	dev = dev_get_by_index_rcu(net, ifindex);
+	if (dev && dev->netdev_ops == &netdev_ops) {
+		wg = netdev_priv(dev);
+		dev_hold(wg->dev);
+	}
+	rcu_read_unlock();
+
+	return wg;
+}
