diff --git a/kernel-src/bpf.c b/kernel-src/bpf.c
new file mode 100644
index 0000000..5afb4fd
--- /dev/null
+++ b/kernel-src/bpf.c
@@ -0,0 +1,481 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <linux/bpf.h>
+#include <linux/btf.h>
+#include <linux/netdevice.h>
+#include <net/xdp.h>
+
+#include "bpf.h"
+#include "device.h"
+#include "peer.h"
+#include "socket.h"
+#include "timers.h"
+
+static struct wg_device *
+bpf_wolf_device_get_by_index(struct net *caller_net, u32 ifindex, s32 netns_id,
+			   int *err)
+{
+	struct wg_device *wg;
+	struct net *net;
+
+	if (unlikely(!ifindex || netns_id < BPF_F_CURRENT_NETNS)) {
+		*err = -EINVAL;
+		return NULL;
+	}
+
+	if (netns_id >= 0) {
+		net = get_net_ns_by_id(caller_net, netns_id);
+		if (unlikely(!net)) {
+			*err = -ENOENT;
+			return NULL;
+		}
+
+		wg = wg_device_get_by_index(net, ifindex);
+		put_net(net);
+	} else {
+		net = caller_net;
+		wg = wg_device_get_by_index(net, ifindex);
+	}
+
+	if (unlikely(!wg)) {
+		*err = -ENODEV;
+		return NULL;
+	}
+
+	*err = 0;
+	return wg;
+}
+
+__bpf_kfunc_start_defs();
+
+/**
+ * bpf_xdp_wolf_device_get_by_index() - Get wolfguard device by ifindex.
+ * @xdp_ctx: XDP context pointer.
+ * @ifindex: Interface index.
+ * @netns_id: Network namespace ID or BPF_F_CURRENT_NETNS.
+ * @err: Pointer to error value.
+ *
+ * Retrieves a reference to the wolfguard device associated with the given
+ * @ifindex from an XDP program. The device reference must be released using
+ * bpf_wolf_device_put().
+ *
+ * Return:
+ * * Pointer to &struct wg_device on success.
+ * * NULL on error, with @err set to one of the following:
+ *   -EINVAL - @ifindex is zero or @netns_id is less than BPF_F_CURRENT_NETNS
+ *   -ENOENT - No network namespace found for @netns_id
+ *   -ENODEV - No wolfguard device found for @ifindex
+ */
+__bpf_kfunc struct wg_device *
+bpf_xdp_wolf_device_get_by_index(struct xdp_md *xdp_ctx, u32 ifindex, s32 netns_id, int *err)
+{
+	struct xdp_buff *ctx = (struct xdp_buff *)xdp_ctx;
+	struct net *caller_net = dev_net(ctx->rxq->dev);
+
+	return bpf_wolf_device_get_by_index(caller_net, ifindex, netns_id, err);
+}
+
+/**
+ * bpf_skb_wolf_device_get_by_index() - Get wolfguard device by ifindex.
+ * @skb_ctx: SKB context pointer.
+ * @ifindex: Interface index.
+ * @netns_id: Network namespace ID or BPF_F_CURRENT_NETNS.
+ * @err: Pointer to error value.
+ *
+ * Retrieves a reference to the wolfguard device associated with the given
+ * @ifindex from a TC or socket-related program. The device reference must
+ * be released using bpf_wolf_device_put().
+ *
+ * Return:
+ * * Pointer to &struct wg_device on success.
+ * * NULL on error, with @err set to one of the following:
+ *   -EINVAL - @ifindex is zero or @netns_id is less than BPF_F_CURRENT_NETNS
+ *   -ENOENT - No network namespace found for @netns_id
+ *   -ENODEV - No wolfguard device found for @ifindex
+ */
+__bpf_kfunc struct wg_device *
+bpf_skb_wolf_device_get_by_index(struct __sk_buff *skb_ctx, u32 ifindex, s32 netns_id, int *err)
+{
+	struct sk_buff *skb = (struct sk_buff *)skb_ctx;
+	struct net *caller_net;
+
+	caller_net = skb->dev ? dev_net(skb->dev) : sock_net(skb->sk);
+	return bpf_wolf_device_get_by_index(caller_net, ifindex, netns_id, err);
+}
+
+/**
+ * bpf_wolf_device_get_from_sk() - Get wolfguard device from socket.
+ * @sk: Socket pointer.
+ *
+ * Retrieves a reference to the wolfguard device associated with the given
+ * socket @sk. The device reference must be released using bpf_wolf_device_put().
+ *
+ * Return:
+ * * Pointer to &struct wg_device on success.
+ * * NULL on error, if @sk is not a wolfguard socket.
+ */
+__bpf_kfunc struct wg_device *
+bpf_wolf_device_get_from_sk(struct sock *sk)
+{
+	return wg_socket_device_get_from_sk(sk);
+}
+
+/**
+ * bpf_wolf_peer_allowedips_lookup() - Lookup wolfguard peer by allowed IPs.
+ * @wg: WolfGuard device pointer.
+ * @addr: IP address to lookup.
+ * @addr__sz: Size of @addr.
+ *
+ * Looks up a wolfguard peer based on the provided IP address @addr. This is
+ * typically used to find the peer for outbound traffic before encrypting,
+ * but can also be used to check if the decrypted source IP is in the
+ * allowed IPs list. The returned peer reference must be released using
+ * bpf_wolf_peer_put().
+ *
+ * Return:
+ * * Pointer to &struct wg_peer on success.
+ * * NULL if the IP is not routed through the WolfGuard device or the peer is dead.
+ */
+__bpf_kfunc struct wg_peer *
+bpf_wolf_peer_allowedips_lookup(struct wg_device *wg, const void *addr,
+			      u32 addr__sz)
+{
+	struct wg_peer *peer;
+
+	peer = wg_allowedips_lookup_bpf(&wg->peer_allowedips, addr, addr__sz);
+	if (unlikely(!peer))
+		return NULL;
+
+	if (unlikely(READ_ONCE(peer->is_dead))) {
+		wg_peer_put(peer);
+		return NULL;
+	}
+
+	return peer;
+}
+
+/**
+ * bpf_wolf_keypair_hashtable_lookup() - Lookup wolfguard keypair by hashtable index.
+ * @wg: WolfGuard device pointer.
+ * @key_idx: Key index in hashtable.
+ * @peer_addr: Pointer to be populated with the peer address.
+ *
+ * Looks up a wolfguard peer and its current receiving keypair based on the
+ * receiver index @key_idx. This is typically used to find the decryption keys
+ * for inbound wolfguard data packets. @peer_addr is populated with the peer
+ * address, which can be used to verify cryptokey routing by comparing it
+ * against the peer returned from bpf_wolf_peer_allowedips_lookup().
+ * The returned keypair reference must be released using bpf_wolf_keypair_put().
+ *
+ * Return:
+ * * Pointer to &struct noise_keypair on success.
+ * * NULL if no keypair was found or the peer is dead.
+ */
+__bpf_kfunc struct noise_keypair *
+bpf_wolf_keypair_hashtable_lookup(struct wg_device *wg, __le32 key_idx,
+				unsigned long *peer_addr)
+{
+	struct noise_keypair *keypair;
+	struct wg_peer *peer = NULL;
+
+	rcu_read_lock_bh();
+	keypair = (struct noise_keypair *)wg_index_hashtable_lookup(
+		wg->index_hashtable, INDEX_HASHTABLE_KEYPAIR, key_idx, &peer);
+	keypair = wg_noise_keypair_get(keypair);
+	rcu_read_unlock_bh();
+
+	if (unlikely(!keypair))
+		goto err_keypair;
+	if (unlikely(READ_ONCE(peer->is_dead)))
+		goto err;
+
+	*peer_addr = (unsigned long)peer;
+	return keypair;
+
+err:
+	wg_noise_keypair_put(keypair, false);
+err_keypair:
+	wg_peer_put(peer);
+	return NULL;
+}
+
+/**
+ * bpf_wolf_endpoint_tuple_get() - Get wolfguard endpoint tuple.
+ * @peer: WolfGuard peer pointer.
+ * @tuple: Pointer to a bpf_sock_tuple to write to.
+ *
+ * Retrieves the socket tuple (source and destination IPs and ports) associated
+ * with the wolfguard @peer's endpoint.
+ *
+ * Return:
+ * * Address family on success.
+ * * Error code on failure:
+ *   -EDESTADDRREQ - Endpoint address family is not AF_INET or AF_INET6
+ */
+__bpf_kfunc int
+bpf_wolf_endpoint_tuple_get(struct wg_peer *peer, struct bpf_sock_tuple *tuple)
+{
+	u16 sport = htons(peer->device->incoming_port);
+	struct endpoint *endpoint = &peer->endpoint;
+	int ret;
+
+	read_lock_bh(&peer->endpoint_lock);
+	switch (endpoint->addr.sa_family) {
+	case AF_INET:
+		tuple->ipv4.daddr = endpoint->addr4.sin_addr.s_addr;
+		tuple->ipv4.dport = endpoint->addr4.sin_port;
+		tuple->ipv4.saddr = endpoint->src4.s_addr;
+		tuple->ipv4.sport = sport;
+		ret = AF_INET;
+		break;
+	case AF_INET6:
+		memcpy(tuple->ipv6.daddr, &endpoint->addr6.sin6_addr,
+		       sizeof(tuple->ipv6.daddr));
+		memcpy(tuple->ipv6.saddr, &endpoint->src6,
+		       sizeof(tuple->ipv6.saddr));
+		tuple->ipv6.dport = endpoint->addr6.sin6_port;
+		tuple->ipv6.sport = sport;
+		ret = AF_INET6;
+		break;
+	default:
+		ret = -EDESTADDRREQ;
+	}
+	read_unlock_bh(&peer->endpoint_lock);
+
+	return ret;
+}
+
+/**
+ * bpf_wolf_encrypt() - Encrypt a wolfguard packet.
+ * @ptr: Pointer to the bpf_dynptr containing the packet data.
+ * @peer: WolfGuard peer pointer.
+ * @counter: Pointer to be populated with the used nonce counter.
+ *
+ * Encrypts the payload of the packet referenced by @ptr in-place using the
+ * current sending key from @peer's session. The exact bounds of the packet
+ * to encrypt are extracted natively from the provided dynptr. The incremented
+ * counter used as the nonce is returned in @counter.
+ *
+ * Return:
+ * * The remote_index (>= 0) on success.
+ * * Negative error code on failure:
+ *   -EINVAL
+ *     - The dynptr was not initialized correctly
+ *     - The dynptr is read-only
+ *     - The dynptr length is not a multiple of 16
+ *   -E2BIG - The dynptr length is out of bounds
+ *   -EOPNOTSUPP - The dynptr is not of type XDP or SKB
+ *   -EMSGSIZE - The packet exceeds the maximum allowed size or is too fragmented
+ *   -EKEYEXPIRED - The sending counter reached REJECT_AFTER_MESSAGES
+ *   -EBADMSG - The encryption operation failed
+ */
+__bpf_kfunc long
+bpf_wolf_encrypt(struct bpf_dynptr *ptr, struct wg_peer *peer, u64 *counter)
+{
+	struct bpf_dynptr_kern *ptr_kern = (struct bpf_dynptr_kern *)ptr;
+	struct scatterlist sg[MAX_SKB_FRAGS + 8];
+	struct noise_keypair *keypair;
+	size_t plaintext_len;
+	u32 length;
+	u64 nonce;
+	long ret;
+
+	if (unlikely(!ptr_kern->data || __bpf_dynptr_is_rdonly(ptr_kern)))
+		return -EINVAL;
+
+	length = __bpf_dynptr_size(ptr_kern);
+	if (unlikely(length <= noise_encrypted_len(0) ||
+			!IS_ALIGNED(length, MESSAGE_PADDING_MULTIPLE)))
+		return -EINVAL;
+
+	rcu_read_lock_bh();
+	keypair = wg_noise_keypair_get(
+		rcu_dereference_bh(peer->keypairs.current_keypair));
+	rcu_read_unlock_bh();
+
+	if (unlikely(!keypair || !READ_ONCE(keypair->sending.is_valid))) {
+		ret = -EKEYEXPIRED;
+		goto out;
+	}
+
+	if (unlikely(wg_birthdate_has_expired(keypair->sending.birthdate,
+					      REJECT_AFTER_TIME))) {
+		WRITE_ONCE(keypair->sending.is_valid, false);
+		ret = -EKEYEXPIRED;
+		goto out;
+	}
+
+	nonce = atomic64_inc_return(&keypair->sending_counter) - 1;
+	if (unlikely(nonce >= REJECT_AFTER_MESSAGES)) {
+		WRITE_ONCE(keypair->sending.is_valid, false);
+		ret = -EKEYEXPIRED;
+		goto out;
+	}
+
+	ret = bpf_dynptr_to_sgvec(ptr_kern, sg, ARRAY_SIZE(sg));
+	if (unlikely(ret < 0))
+		goto out;
+
+	plaintext_len = length - noise_encrypted_len(0);
+	if (unlikely(!wc_AesGcm_encrypt_sg_inplace(sg,
+			plaintext_len, NULL, 0, nonce, keypair->sending.key,
+			sizeof(keypair->sending.key)))) {
+		ret = -EBADMSG;
+		goto out;
+	}
+
+	wg_noise_send_keep_key_fresh(peer);
+	ret = (long)keypair->remote_index;
+	*counter = nonce;
+
+out:
+	wg_noise_keypair_put(keypair, false);
+	return ret;
+}
+
+/**
+ * bpf_wolf_decrypt() - Decrypt a wolfguard packet.
+ * @ptr: Pointer to the bpf_dynptr containing the packet data.
+ * @keypair: WolfGuard keypair pointer.
+ * @counter: Nonce counter used for decryption.
+ *
+ * Decrypts the payload of the packet referenced by @ptr in-place using the
+ * provided @keypair. The exact bounds of the packet to decrypt are extracted
+ * natively from the provided dynptr. The @counter is used as the nonce and
+ * is checked if it is valid.
+ *
+ * Return:
+ * * 0 on success.
+ * * Error code on failure:
+ *   -EINVAL
+ *     - The dynptr was not initialized correctly
+ *     - The dynptr is read-only
+ *     - The SKB is cloned
+ *   -E2BIG - The dynptr length is out of bounds
+ *   -EOPNOTSUPP - The dynptr is not of type XDP or SKB
+ *   -EMSGSIZE - The packet exceeds the maximum allowed size or is too fragmented
+ *   -EBADMSG - The decryption operation failed
+ *   -EPROTO - The nonce counter validation failed
+ */
+__bpf_kfunc long
+bpf_wolf_decrypt(struct bpf_dynptr *ptr, struct noise_keypair *keypair, u64 counter)
+{
+	struct bpf_dynptr_kern *ptr_kern = (struct bpf_dynptr_kern *)ptr;
+	struct wg_peer *peer = keypair->entry.peer;
+	struct scatterlist sg[MAX_SKB_FRAGS + 8];
+	u32 length;
+	long ret;
+
+	if (unlikely(!ptr_kern->data || __bpf_dynptr_is_rdonly(ptr_kern)))
+		return -EINVAL;
+
+	length = __bpf_dynptr_size(ptr_kern);
+	if (unlikely(length <= noise_encrypted_len(0)))
+		return -EINVAL;
+
+	if (unlikely(!READ_ONCE(keypair->receiving.is_valid)))
+		return -EKEYEXPIRED;
+
+	if (unlikely(wg_birthdate_has_expired(keypair->receiving.birthdate,
+					      REJECT_AFTER_TIME) ||
+		     READ_ONCE(keypair->receiving_counter.counter) >=
+			     REJECT_AFTER_MESSAGES)) {
+		WRITE_ONCE(keypair->receiving.is_valid, false);
+		return -EKEYEXPIRED;
+	}
+
+	ret = bpf_dynptr_to_sgvec(ptr_kern, sg, ARRAY_SIZE(sg));
+	if (unlikely(ret < 0))
+		return ret;
+
+	if (unlikely(!wc_AesGcm_decrypt_sg_inplace(sg,
+		    length, NULL, 0, counter, keypair->receiving.key,
+		    sizeof(keypair->receiving.key))))
+		return -EBADMSG;
+
+	if (unlikely(!wg_noise_counter_validate(&keypair->receiving_counter,
+						counter)))
+		return -EPROTO;
+
+	wg_noise_receive_keep_key_fresh(peer);
+	wg_timers_any_authenticated_packet_received(peer);
+	wg_timers_any_authenticated_packet_traversal(peer);
+	return 0;
+}
+
+/**
+ * bpf_wolf_device_put() - Release wolfguard device.
+ * @wg: WolfGuard device pointer.
+ *
+ * Decrements the reference count of the wolfguard device @wg previously
+ * acquired by a bpf_*_wolf_device_get_* kfunc.
+ */
+__bpf_kfunc void
+bpf_wolf_device_put(struct wg_device *wg)
+{
+	dev_put(wg->dev);
+}
+
+/**
+ * bpf_wolf_peer_put() - Release wolfguard peer.
+ * @peer: WolfGuard peer pointer.
+ *
+ * Decrements the reference count of the wolfguard peer @peer previously
+ * acquired by a bpf_wolf_peer_*_lookup kfunc.
+ */
+__bpf_kfunc void
+bpf_wolf_peer_put(struct wg_peer *peer)
+{
+	wg_peer_put(peer);
+}
+
+/**
+ * bpf_wolf_keypair_put() - Release wolfguard keypair.
+ * @keypair: WolfGuard keypair pointer.
+ *
+ * Decrements the reference count of the wolfguard keypair @keypair previously
+ * acquired by a bpf_wolf_keypair_*_lookup and its belonging peer kfunc.
+ */
+__bpf_kfunc void
+bpf_wolf_keypair_put(struct noise_keypair *keypair)
+{
+	struct wg_peer *peer = keypair->entry.peer;
+
+	wg_noise_keypair_put(keypair, false);
+	wg_peer_put(peer);
+}
+
+__bpf_kfunc_end_defs();
+
+BTF_KFUNCS_START(wolf_kfunc_set)
+BTF_ID_FLAGS(func, bpf_xdp_wolf_device_get_by_index, KF_ACQUIRE | KF_RET_NULL)
+BTF_ID_FLAGS(func, bpf_skb_wolf_device_get_by_index, KF_ACQUIRE | KF_RET_NULL)
+BTF_ID_FLAGS(func, bpf_wolf_device_get_from_sk,
+	     KF_ACQUIRE | KF_RET_NULL | KF_TRUSTED_ARGS)
+BTF_ID_FLAGS(func, bpf_wolf_peer_allowedips_lookup,
+	     KF_ACQUIRE | KF_RET_NULL | KF_TRUSTED_ARGS)
+BTF_ID_FLAGS(func, bpf_wolf_keypair_hashtable_lookup,
+	     KF_ACQUIRE | KF_RET_NULL | KF_TRUSTED_ARGS)
+BTF_ID_FLAGS(func, bpf_wolf_endpoint_tuple_get, KF_TRUSTED_ARGS)
+BTF_ID_FLAGS(func, bpf_wolf_encrypt, KF_TRUSTED_ARGS)
+BTF_ID_FLAGS(func, bpf_wolf_decrypt, KF_TRUSTED_ARGS)
+BTF_ID_FLAGS(func, bpf_wolf_device_put, KF_RELEASE)
+BTF_ID_FLAGS(func, bpf_wolf_peer_put, KF_RELEASE)
+BTF_ID_FLAGS(func, bpf_wolf_keypair_put, KF_RELEASE)
+BTF_KFUNCS_END(wolf_kfunc_set)
+
+static const struct btf_kfunc_id_set wolfguard_kfunc_set = {
+	.owner = THIS_MODULE,
+	.set = &wolf_kfunc_set,
+};
+
+int __init register_wolfguard_bpf(void)
+{
+	int ret;
+
+	ret = register_btf_kfunc_id_set(BPF_PROG_TYPE_XDP,
+					&wolfguard_kfunc_set);
+	ret = ret ?: register_btf_kfunc_id_set(BPF_PROG_TYPE_SCHED_CLS,
+					&wolfguard_kfunc_set);
+	return ret;
+}
