+int bpf_xdp_to_sgvec(struct xdp_buff *xdp, struct scatterlist *sg,
+               	   	 u32 offset, u32 len)
+{
+    struct skb_shared_info *sinfo = xdp_get_shared_info_from_buff(xdp);
+    int start = xdp->data_end - xdp->data;
+    int i, copy = start - offset;
+    int elt = 0;
+
+    /* Linear part in xdp->data..data_end */
+    if (copy > 0) {
+        if (copy > len)
+            copy = len;
+        sg_set_buf(sg, xdp->data + offset, copy);
+        elt++;
+        if ((len -= copy) == 0)
+            goto out;
+        offset += copy;
+    }
+
+	if (!xdp_buff_has_frags(xdp))
+		goto out;
+
+    /* Page frags from xdp_shared_info */
+    for (i = 0; i < sinfo->nr_frags; i++) {
+        int end;
+
+		WARN_ON(start > offset + len);
+
+		end = start + skb_frag_size(&sinfo->frags[i]);
+        if ((copy = end - offset) > 0) {
+            skb_frag_t *frag = &sinfo->frags[i];
+			if (unlikely(elt && sg_is_last(&sg[elt - 1])))
+				return -EMSGSIZE;
+
+            if (copy > len)
+                copy = len;
+            sg_set_page(&sg[elt], skb_frag_page(frag), copy,
+                        skb_frag_off(frag) + offset - start);
+            elt++;
+            if (!(len -= copy))
+                goto out;
+            offset += copy;
+        }
+        start = end;
+    }
+
+out:
+	if (elt)
+    	sg_mark_end(&sg[elt - 1]);
+
+    BUG_ON(len);
+    return elt;
+}
+EXPORT_SYMBOL_GPL(bpf_xdp_to_sgvec);
